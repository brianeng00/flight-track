// Copy to Secrets.xcconfig (same folder) and fill in. Secrets.xcconfig is gitignored.
// Tip: xcconfig treats "//" as a comment, so never paste a URL here.

// Your Apple ID's team: Xcode > Settings > Accounts > (your Apple ID) > Team ID column.
FT_TEAM_ID = ABCDE12345
// Anything unique, reverse-DNS style. The widget uses <this>.widget automatically.
FT_BUNDLE_ID = com.yourname.flighttrack

// AeroDataBox (free Basic plan). Fill in ONE of these, whichever marketplace you signed up on.
ADB_APIMARKET_KEY =
ADB_RAPIDAPI_KEY =

// OpenSky (optional, raises the daily limit). Same values as VITE_OPENSKY_* in the web app's .env.
OPENSKY_CLIENT_ID =
OPENSKY_CLIENT_SECRET =
