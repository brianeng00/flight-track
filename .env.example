# OpenSky Network OAuth2 credentials (optional — improves rate limit from 400 to 4,000 req/day)
# Sign up at https://opensky-network.org/index.php?option=com_users&view=registration
# Then create a client at https://opensky-network.org/index.php?option=com_users&view=profile
VITE_OPENSKY_CLIENT_ID=your_client_id
VITE_OPENSKY_CLIENT_SECRET=your_client_secret

# MapTiler API key (optional — enables Satellite and Terrain map modes)
# Get a free key at https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=your_maptiler_key
